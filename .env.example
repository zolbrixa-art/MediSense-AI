# MediSense AI — Environment Configuration

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-change-in-production

# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
# Leave unset to use the default absolute SQLite path (db/medisense.db).
# DATABASE_URL=sqlite:///absolute/path/to/medisense.db
# Microsoft SQL Server (uncomment when ODBC Driver 17/18 is available)
# DATABASE_URL=mssql+pyodbc://username:password@server/MediSenseDB?driver=ODBC+Driver+17+for+SQL+Server

# AI Services
# Leave empty or unset to use deterministic mock mode
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=25
